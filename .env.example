# Server
HOST=0.0.0.0
PORT=1337

# Comma-separated frontend origins permitted to call the Content API.
# Add the production frontend URL before deployment, e.g. https://www.example.com
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Generate unique, comma-separated secrets before deployment.
# Example: openssl rand -base64 32
APP_KEYS=replace-with-first-secret,replace-with-second-secret,replace-with-third-secret,replace-with-fourth-secret
API_TOKEN_SALT=replace-with-a-unique-secret
ADMIN_JWT_SECRET=replace-with-a-unique-secret
TRANSFER_TOKEN_SALT=replace-with-a-unique-secret
ENCRYPTION_KEY=replace-with-a-unique-secret

# SQLite database persisted by the strapi-data Docker volume.
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db
